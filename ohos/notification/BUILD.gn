import("//build/templates/cangjie/cjc.gni")

ohos_cangjie_shared_library("ohos.notification_manager") {

  if (is_mingw || is_mac){
    sources = [ "../../mock/ohos.notification_manager.cj" ]
  } else {
    sources = [
      "notification_basic_content.cj",
      "notification_common.cj",
      "notification_content.cj",
      "notification_ffi.cj",
      "notification_manager.cj",
      "notification_request.cj",
    ]
  }

  external_deps = [ "distributed_notification_service:cj_notification_manager_ffi" ]

  cj_external_deps = [
    "cangjie_ark_interop:ohos.business_exception",
    "cangjie_ark_interop:ohos.ffi",
    "cangjie_ark_interop:ohos.labels",
    "multimedia_cangjie_wrapper:ohos.multimedia.image",
    "ability_cangjie_wrapper:ohos.app.ability.ui_ability",
  ]

  subsystem_name = "notification"
  part_name = "notification_cangjie_wrapper"
}
